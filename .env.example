SECRET_KEY=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allowlist. Leave empty only for a deliberately open local demo.
ALLOWED_EMAILS=first@example.com,second@example.com,third@example.com
# Format: Role:email,Role:email
USER_ROLES=Admin:first@example.com,Member:second@example.com,Member:third@example.com
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
